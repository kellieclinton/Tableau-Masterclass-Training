      <aliases enabled='yes' />
      <column caption='Python Regression Line' datatype='real' name='[Calculation_0291977315381248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SCRIPT_REAL(&quot;&#13;&#10;import numpy as np&#13;&#10;from sklearn.linear_model import LinearRegression&#13;&#10;&#13;&#10;# Reshape data for scikit-learn&#13;&#10;x = np.array(_arg1).reshape(-1, 1)&#13;&#10;y = np.array(_arg2)&#13;&#10;&#13;&#10;# Fit the linear model and predict&#13;&#10;model = LinearRegression().fit(x, y)&#13;&#10;predictions = model.predict(x)&#13;&#10;&#13;&#10;# Return a list matching the input size&#13;&#10;return list(predictions)&#13;&#10;&quot;, SUM([Sales]), SUM([Profit]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Slope Description' datatype='string' name='[Calculation_0291977321902081]' role='measure' type='nominal'>
        <calculation class='tableau' formula='SCRIPT_STR(&quot;&#13;&#10;import numpy as np&#13;&#10;# Fit a 1st-degree polynomial (linear regression)&#13;&#10;slope, intercept = np.polyfit(_arg1, _arg2, 1)&#13;&#10;&#13;&#10;# Return the equation as a text string repeated for rows&#13;&#10;equation = f&apos;y = {slope:.4f} * x + {intercept:.4f}&apos;&#13;&#10;return [equation] * len(_arg1)&#13;&#10;&quot;, SUM([Sales]), SUM([Profit]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Sum Sales &amp; Profit' datatype='real' name='[Calculation_0543490140127232]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SCRIPT_REAL(&quot;&#13;&#10;import numpy as np&#13;&#10;# Calculate the single correlation value&#13;&#10;corr = np.corrcoef(_arg1, _arg2)[0,1]&#13;&#10;&#13;&#10;# Repeat that value for every single row so Tableau can map it&#13;&#10;return [corr] * len(_arg1)&#13;&#10;&quot;, SUM([Sales]), SUM([Profit]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
